<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_pearl"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Profile Header Frosted Pearl Glass Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMyInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Top Dynamic Brand Gradient Strip -->
                    <View
                        android:id="@+id/viewCardAccent"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_card_accent_instagram" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <!-- User Avatar with Ring Glow & Online Dot -->
                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar_glow_ring" />

                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_avatar_circle">

                                <TextView
                                    android:id="@+id/tvAvatarIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="👤"
                                    android:textSize="26sp"
                                    android:gravity="center" />

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivCardPhotoPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                            </FrameLayout>

                            <!-- Online NFC Status Dot -->
                            <View
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_status_dot_online" />

                            <!-- Small Remove Photo Badge -->
                            <ImageButton
                                android:id="@+id/btnRemovePhotoBadge"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_avatar_circle"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="@color/error"
                                android:visibility="gone"
                                android:contentDescription="Remove photo" />
                        </FrameLayout>

                        <!-- User Details -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvMyName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tejender"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/slate_900" />

                                <TextView
                                    android:id="@+id/tvProBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PRO"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary"
                                    android:background="@drawable/bg_pro_pill"
                                    android:paddingHorizontal="7dp"
                                    android:paddingVertical="1.5dp"
                                    android:layout_marginStart="8dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="2dp">

                                <TextView
                                    android:id="@+id/tvMyPhone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+91 XXXXX XXXXX"
                                    android:textSize="12sp"
                                    android:textColor="@color/slate_500" />

                                <ImageButton
                                    android:id="@+id/btnCopyPhone"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_copy"
                                    android:layout_marginStart="4dp"
                                    android:contentDescription="Copy phone number" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvPhotoAttachedLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📸 Photo attached to card"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary"
                                android:visibility="gone"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Edit Profile Frosted Button -->
                        <ImageButton
                            android:id="@+id/btnEditProfile"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_icon_button"
                            android:src="@drawable/ic_edit_pencil"
                            app:tint="@color/slate_600"
                            android:contentDescription="Edit Profile" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Action Pill: Select Photos -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectPhotos"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="SELECT PHOTOS  📸"
                android:textColor="@color/slate_700"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="14dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp"
                android:backgroundTint="@color/surface" />

            <!-- Progress bar (hidden when idle) -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Beam Photo via Nearby button (if user selects photo) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBeamNearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="⚡ Beam Photo via Nearby"
                android:visibility="gone"
                app:cornerRadius="20dp" />

            <!-- Sliding Screen Container (Replaces small chip toolbar with swipeable slides) -->
            <LinearLayout
                android:id="@+id/layoutSlideContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginTop="10dp">

                <!-- Current Platform Title Pill Bar with Navigation Chevrons -->
                <LinearLayout
                    android:id="@+id/layoutPlatformPill"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_platform_pill"
                    android:paddingHorizontal="6dp"
                    android:elevation="1dp">

                    <ImageButton
                        android:id="@+id/btnSlidePrev"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_chevron_left"
                        android:contentDescription="Previous Profile" />

                    <TextView
                        android:id="@+id/tvCurrentPlatformTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📸 INSTAGRAM"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_900"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="10dp" />

                    <ImageButton
                        android:id="@+id/btnSlideNext"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Next Profile" />
                </LinearLayout>

                <!-- Swipeable Profile Slide Screens (ViewPager2) -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpShareSlides"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginTop="2dp" />

                <!-- Page Dots Indicator (Cleanly separated from prompt text) -->
                <LinearLayout
                    android:id="@+id/layoutSlideIndicators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp">

                    <View
                        android:id="@+id/viewDot0"
                        android:layout_width="18dp"
                        android:layout_height="6dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_indicator_active" />

                    <View
                        android:id="@+id/viewDot1"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_indicator_inactive" />

                    <View
                        android:id="@+id/viewDot2"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_indicator_inactive" />

                    <View
                        android:id="@+id/viewDot3"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_indicator_inactive" />

                    <View
                        android:id="@+id/viewDot4"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_indicator_inactive" />
                </LinearLayout>

                <!-- Swipe Hint -->
                <TextView
                    android:id="@+id/tvSwipeHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹ Swipe left or right to switch profiles ›"
                    android:textSize="11sp"
                    android:textColor="@color/slate_400"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Scan Mode Dedicated Area (Shown only when in Scan Mode) -->
            <LinearLayout
                android:id="@+id/layoutScanModeArea"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="180dp"
                    android:layout_height="180dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_radar_ring_outer" />

                    <View
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_radar_ring_mid" />

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_beacon_orb_contact"
                        android:padding="3dp"
                        android:elevation="4dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_beacon_inner_white">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_search_scan"
                                app:tint="@color/primary"
                                android:contentDescription="Scanner" />
                        </FrameLayout>
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"
                    android:background="@drawable/bg_capsule_broadcast_contact">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_white"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scanner Mode: Active"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/surface" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvScanStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🔍 Hold near another phone or NFC tag to read profile"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900"
                    android:gravity="center"
                    android:paddingHorizontal="24dp" />
            </LinearLayout>

            <!-- Action Controls & User Instruction Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="10dp">

                <!-- Primary Action CTA: Switch to Scan Mode -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleScanMode"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="SWITCH TO SCAN MODE"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:icon="@drawable/ic_search_scan"
                    app:iconTint="@color/primary"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/indigo_pro_border"
                    app:strokeWidth="1.5dp"
                    android:backgroundTint="@color/surface" />

                <!-- "How does tap sharing work?" Modal Trigger Pill -->
                <LinearLayout
                    android:id="@+id/btnHowItWorks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_how_it_works_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_info_circle"
                        app:tint="@color/primary"
                        android:contentDescription="Info" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How does tap sharing work?"
                        android:textSize="11sp"
                        android:textColor="@color/slate_600"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Hidden legacy hint text (kept for binding compatibility) -->
                <TextView
                    android:id="@+id/tvNfcHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- View History Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="VIEW HISTORY"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/primary"
                    app:icon="@drawable/ic_history_doc"
                    app:iconTint="@color/primary"
                    app:iconPadding="6dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
